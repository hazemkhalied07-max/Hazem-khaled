    {
      "parameters": {
        "jsCode": "// Parse and structure social media data\nconst results = [];\n\nfor (const item of $input.all()) {\n  const company = item.json.name || 'Unknown';\n  const platform = item.json.platform || 'Unknown';\n  const rawData = item.json;\n  \n  // Try to extract posts from different platform formats\n  let posts = [];\n  \n  // Instagram format\n  if (rawData.graphql && rawData.graphql.user) {\n    const edges = rawData.graphql.user.edge_owner_to_timeline_media?.edges || [];\n    posts = edges.map(edge => ({\n      company: company,\n      platform: 'Instagram',\n      post_id: edge.node.id,\n      caption: edge.node.edge_media_to_caption.edges[0]?.node.text || '',\n      image_url: edge.node.display_url,\n      likes: edge.node.edge_liked_by.count,\n      comments: edge.node.edge_media_to_comment.count,\n      timestamp: new Date(edge.node.taken_at_timestamp * 1000).toISOString(),\n      url: `https://www.instagram.com/p/${edge.node.shortcode}/`\n    }));\n  }\n  \n  // Twitter RSS format\n  if (rawData.body && rawData.body.includes('<rss')) {\n    // Simple RSS parsing (in production, use proper XML parser)\n    const items = rawData.body.match(/<item>([\\s\\S]*?)<\\/item>/g) || [];\n    posts = items.slice(0, 10).map((item, idx) => {\n      const title = item.match(/<title><!\\[CDATA\\[(.*?)\\]\\]><\\/title>/)?.[1] || '';\n      const link = item.match(/<link>(.*?)<\\/link>/)?.[1] || '';\n      const pubDate = item.match(/<pubDate>(.*?)<\\/pubDate>/)?.[1] || '';\n      \n      return {\n        company: company,\n        platform: 'Twitter/X',\n        post_id: `tweet_${idx}`,\n        caption: title,\n        url: link,\n        timestamp: new Date(pubDate).toISOString(),\n        likes: null,\n        comments: null\n      };\n    });\n  }\n  \n  // Facebook format (basic HTML scraping)\n  if (rawData.body && rawData.body.includes('facebook.com')) {\n    // Note: Facebook scraping is limited without API\n    posts.push({\n      company: company,\n      platform: 'Facebook',\n      post_id: 'manual_check_required',\n      caption: 'Facebook requires manual verification or API access',\n      url: `https://www.facebook.com/${rawData.facebook}`,\n      timestamp: new Date().toISOString(),\n      likes: null,\n      comments: null\n    });\n  }\n  \n  results.push(...posts);\n}\n\nreturn results.map(post => ({ json: post }));"
      },
