            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-offers-found",
              "leftValue": "={{ $json.total_offers_found }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
