      "id": "extract-offers-page",
      "name": "Extract Offers Page Data",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [740, 520]
    },
    {
      "parameters": {
        "jsCode": "// Combine and structure offers from both sources\nconst homepageData = $('Extract Homepage Offers').first().json;\nconst offersPageData = $('Extract Offers Page Data').first().json;\n\nconst now = new Date().toISOString();\nconst allOffers = [];\n\n// Process homepage offers\nfunction processOffers(data, source) {\n  const titles = data.offer_titles || [];\n  const prices = data.offer_prices || [];\n  const oldPrices = data.offer_old_prices || [];\n  const images = data.offer_images || [];\n  const links = data.offer_links || [];\n  const discounts = data.discount_badges || [];\n\n  const maxLength = Math.max(titles.length, prices.length, links.length);\n\n  for (let i = 0; i < maxLength; i++) {\n    const title = titles[i] ? titles[i].trim() : '';\n    const price = prices[i] ? prices[i].trim() : '';\n    const oldPrice = oldPrices[i] ? oldPrices[i].trim() : '';\n    const image = images[i] ? images[i].trim() : '';\n    let link = links[i] ? links[i].trim() : '';\n    const discount = discounts[i] ? discounts[i].trim() : '';\n\n    // Skip empty entries\n    if (!title && !price) continue;\n\n    // Make relative URLs absolute\n    if (link && !link.startsWith('http')) {\n      link = 'https://daralamirat.com.sa' + (link.startsWith('/') ? '' : '/') + link;\n    }\n\n    // Calculate discount percentage if both prices exist\n    let discountPercent = '';\n    if (price && oldPrice) {\n      const currentPrice = parseFloat(price.replace(/[^0-9.]/g, ''));\n      const originalPrice = parseFloat(oldPrice.replace(/[^0-9.]/g, ''));\n      if (originalPrice > 0 && currentPrice > 0) {\n        discountPercent = Math.round(((originalPrice - currentPrice) / originalPrice) * 100) + '%';\n      }\n    }\n\n    allOffers.push({\n      title,\n      current_price: price,\n      original_price: oldPrice,\n      discount_percent: discount || discountPercent,\n      image_url: image,\n      product_link: link,\n      source_page: source,\n      scraped_at: now\n    });\n  }\n}\n\ntry {\n  processOffers(homepageData, 'homepage');\n} catch(e) {\n  // Homepage data might not be available\n}\n\ntry {\n  processOffers(offersPageData, 'offers_page');\n} catch(e) {\n  // Offers page data might not be available\n}\n\n// Remove duplicates based on title\nconst uniqueOffers = allOffers.filter((offer, index, self) =>\n  index === self.findIndex((o) => o.title === offer.title && o.title !== '')\n);\n\nreturn [\n  {\n    json: {\n      website: 'daralamirat.com.sa',\n      website_name: 'دار الأميرات - Dar Alamirat',\n      scrape_date: now,\n      total_offers_found: uniqueOffers.length,\n      offers: uniqueOffers\n    }\n  }\n];"
      },
      "id": "combine-and-structure",
      "name": "Combine & Structure Data",
