      "id": "check-offers-exist",
      "name": "Offers Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1260, 520]
    },
    {
      "parameters": {
        "jsCode": "// If no offers were found with CSS selectors, try alternative approach\n// This logs the issue and provides debugging info\nconst inputData = $input.first().json;\n\nreturn [\n  {\n    json: {\n      status: 'warning',\n      message: 'No offers extracted. The website may use JavaScript rendering (SPA) or the CSS selectors need updating.',\n      suggestion: 'Consider these solutions:',\n      solutions: [\n        '1. Check if the site uses Salla platform - if so, try the Salla API endpoint: https://daralamirat.com.sa/api/products',\n        '2. Use n8n Puppeteer/Playwright node for JavaScript-rendered content',\n        '3. Update CSS selectors after inspecting the actual page HTML',\n        '4. Check if the site has a public API or RSS feed for offers'\n      ],\n      debug_data: inputData,\n      scraped_at: new Date().toISOString()\n    }\n  }\n];"
      },
      "id": "fallback-handler",
      "name": "Fallback - No Offers Found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1520, 620]
    },
    {
      "parameters": {
        "jsCode": "// Summary node - log the results\nconst data = $input.first().json;\n\nreturn [\n  {\n    json: {\n      status: 'success',\n      message: `Successfully scraped ${data.total_offers_found} offers from daralamirat.com.sa`,\n      website: data.website_name,\n      total_offers: data.total_offers_found,\n      date: data.scrape_date,\n      file_saved: `/tmp/daralamirat_offers_${new Date().toISOString().split('T')[0]}.json`\n    }\n  }\n];"
      },
      "id": "success-summary",
      "name": "Success Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1520, 180]
    }
