      "id": "extract-homepage-offers",
      "name": "Extract Homepage Offers",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "offer_titles",
              "cssSelector": ".product-card .product-title, .product-item .product-name, .offer-card .title, [class*='product'] h3, [class*='product'] h2, .product-title a, .product-name a",
              "returnArray": true
            },
            {
              "key": "offer_prices",
              "cssSelector": ".product-card .price, .product-item .price, .offer-card .price, [class*='product'] .price, .product-price, .sale-price, [class*='price']",
              "returnArray": true
            },
            {
              "key": "offer_old_prices",
              "cssSelector": ".product-card .old-price, .product-item .old-price, .offer-card .old-price, [class*='product'] .old-price, .regular-price, del, [class*='was-price'], [class*='original-price']",
              "returnArray": true
            },
            {
              "key": "offer_images",
              "cssSelector": ".product-card img, .product-item img, .offer-card img, [class*='product'] img",
              "returnArray": true,
              "returnValue": "attribute",
              "attribute": "src"
            },
            {
              "key": "offer_links",
              "cssSelector": ".product-card a, .product-item a, .offer-card a, [class*='product'] a[href]",
              "returnArray": true,
              "returnValue": "attribute",
              "attribute": "href"
            },
            {
              "key": "discount_badges",
              "cssSelector": ".badge, .discount, .sale-badge, [class*='discount'], [class*='badge'], [class*='offer'], [class*='sale']",
